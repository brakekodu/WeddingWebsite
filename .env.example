# =====================================================================
# Environment variables — NAMES AND PLACEHOLDERS ONLY.
#
# Copy this file to .env.local (gitignored) and put real values THERE.
# Never put real values in this file. Never commit .env.local.
# Details for every variable: docs/DEPLOYMENT.md
# =====================================================================

# ---------------------------------------------------------------------
# Browser-safe — bundled into client JavaScript. Data is protected by RLS.
# ---------------------------------------------------------------------

# Supabase Dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_…)
# (The legacy "anon" key also works.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ---------------------------------------------------------------------
# Server-only — never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------

# Canonical site origin used to build invitation links and QR codes.
# Origin only: no path, no trailing slash.
#   Local development: http://localhost:3000
#   Production:        https://your-final-wedding-domain   (do not print until set)
APP_BASE_URL=http://localhost:3000

# PRIVILEGED: bypasses Row Level Security. Not used by the app at runtime in
# Phase 1 — only by scripts/ (npm run admin:grant, npm run verify:remote).
# Supabase Dashboard → Project Settings → API Keys → Secret keys (sb_secret_…)
# (The legacy "service_role" key also works.)
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------
# Cloudflare R2 — NOT needed in Phase 1. Leave blank; do not create keys yet.
# ---------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET=brake-wedding
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
